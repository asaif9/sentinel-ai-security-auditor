rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: agents
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - role: string (required, enum: primary, sub-agent)
    //   - specialization: string
    //   - status: string (required, enum: idle, active, offline)
    //   - lastActive: string (format: date-time)
    //
    // Collection: tasks
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - description: string
    //   - status: string (required, enum: pending, in-progress, completed, failed)
    //   - assignedAgentId: string
    //   - steps: list of objects (step, status, result)
    //   - createdAt: string (format: date-time)
    //   - updatedAt: string (format: date-time)
    //
    // Collection: vulnerabilities
    // Fields:
    //   - id: string (required)
    //   - type: string (required)
    //   - severity: string (required, enum: Critical, High, Medium, Low)
    //   - description: string
    //   - remediation: string
    //   - owaspCategory: string (required)
    //   - detectedAt: string (format: date-time)
    //
    // Collection: alerts
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - severity: string (required, enum: Critical, High, Medium, Low)
    //   - message: string (required)
    //   - source: string
    //   - status: string (required, enum: new, acknowledged, resolved)
    //   - notified: boolean
    //   - createdAt: string (format: date-time)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "asaif9@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidAgent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['primary', 'sub-agent'] &&
             data.status in ['idle', 'active', 'offline'];
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ['pending', 'in-progress', 'completed', 'failed'];
    }

    function isValidVulnerability(data) {
      return data.type is string && data.type.size() > 0 &&
             data.severity in ['Critical', 'High', 'Medium', 'Low'] &&
             data.owaspCategory is string;
    }

    function isValidAlert(data) {
      return data.title is string && data.title.size() > 0 &&
             data.severity in ['Critical', 'High', 'Medium', 'Low'] &&
             data.message is string && data.message.size() > 0 &&
             data.status in ['new', 'acknowledged', 'resolved'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test_connection/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      match /entries/{entryId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
      
      match /insights/{insightId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin(); // Only backend admin SDK can write derived analytics
      }

      match /alerts/{alertId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /agents/{agentId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /vulnerabilities/{vulnId} {
      allow read, write: if true;
    }

    match /alerts/{alertId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /threat_journal/{journalId} {
      allow read, write: if true;
    }
  }
}
