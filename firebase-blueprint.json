{
  "entities": {
    "Agent": {
      "title": "Security Agent",
      "description": "An autonomous AI agent specializing in specific security domains.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["primary", "sub-agent"] },
        "specialization": { "type": "string" },
        "status": { "type": "string", "enum": ["idle", "active", "offline"] },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "Task": {
      "title": "Security Task",
      "description": "A multi-step security workflow or individual audit task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed", "failed"] },
        "assignedAgentId": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "string" },
              "status": { "type": "string" },
              "result": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "Vulnerability": {
      "title": "Vulnerability Finding",
      "description": "A security vulnerability identified by an agent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "description": { "type": "string" },
        "remediation": { "type": "string" },
        "owaspCategory": { "type": "string" },
        "detectedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "severity", "owaspCategory"]
    },
    "Alert": {
      "title": "Threat Alert",
      "description": "A real-time threat detection alert based on AI agent findings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "acknowledged", "resolved"] },
        "notified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "severity", "message", "status", "createdAt"]
    },
    "Message": {
      "title": "Agent Message",
      "description": "A message sent between agents in the collaboration hub.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["Status", "Command", "Finding"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["from", "to", "content", "type", "timestamp"]
    },
    "UserEntry": {
      "title": "User Journal Entry",
      "description": "Secure multi-tenant journal entry with structured AI insights and resilience metrics.",
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "reply": { "type": "string" },
        "insight": { "type": "object" },
        "isEncrypted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "reply"]
    },
    "ThreatJournalEntry": {
      "title": "Threat Journal Entry",
      "description": "Architectural threat reflection analyzed by Sentinel-Prime with security considerations and mitigations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "summary": { "type": "string" },
        "riskRating": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "securityConsiderations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "mitigations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "analyzedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "analyzedBy", "createdAt"]
    }
  },
  "firestore": {
    "/threat_journal/{entryId}": {
      "schema": "ThreatJournalEntry",
      "description": "Architect's threat journal entries analyzed by Sentinel-Prime."
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "UserEntry",
      "description": "Multi-tenant user journal reflection partitioned by userId."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Tenant-specific threat alerts, including Adversarial Prompt Attempt security notices."
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Collection of security agents."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of security tasks and workflows."
    },
    "/vulnerabilities/{vulnId}": {
      "schema": "Vulnerability",
      "description": "Collection of identified security vulnerabilities."
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Collection of real-time threat alerts."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of inter-agent messages."
    }
  }
}
